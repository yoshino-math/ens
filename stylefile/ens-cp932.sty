%
% ヘッダとフッタ
%
\def\ensheader{\kamoku\ \kai\ (\date)}
\RequirePackage{fancyhdr, lastpage}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0pt}
\fancyhead{}
\cfoot{\thepage/\pageref{LastPage}}

\makeatletter                                        % デフォルト値の設定
\ifx\headerright\@undefined
\newlength{\headerright}\setlength{\headerright}{8mm}\fi    % ヘッダ右余白
\ifx\footerbottom\@undefined
\newlength{\footerbottom}\setlength{\footerbottom}{8mm}\fi  % ページ数下余白
\makeatother

\setlength\voffset{-1in}
\setlength\headheight{16pt}

% 本文がちょうど中央に来るように調整 (縦)
\setlength\headsep{0.5\paperheight}
\addtolength\headsep{-0.5\textheight}
\addtolength\headsep{-\topmargin}
\addtolength\headsep{-\headheight}


% フッタがちょうど下から\footerbottomの位置に来るように調整
\setlength\footskip{\paperheight}
\addtolength\footskip{-\topmargin}
\addtolength\footskip{-\headheight}
\addtolength\footskip{-\headsep}
\addtolength\footskip{-\textheight}
\addtolength\footskip{-\footerbottom}

% [R]は右端が本文の右端に揃うものであると仮定
\addtolength\headerright{1in}
\addtolength\headerright{\hoffset}
\addtolength\headerright{\oddsidemargin}
\addtolength\headerright{\textwidth}
\addtolength\headerright{-\paperwidth}
\fancyhead[RO]{\ifnum\thepage>1\ensheader\hskip\headerright\fi}


%
% メモ書きのマクロ
