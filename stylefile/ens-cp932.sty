%
% レポート
%
\newcommand{\report}{
\begin{center}
-- レポート提出について --
\end{center}
上の問題を解いてレポート提出してください(どの問題を提出すべきかは演習の
時間に指定します). \\
次回(\jikai)の講義の時間の最初に回収します.
\begin{enumerate}
\item[$\bullet$] レポートの表紙に「\kamoku\ \kai」と書き, 学籍番号・名前を記入してください.
\item[$\bullet$] 二枚以上になる場合はホッチキス(ステープラー)でとめて下さい.
\end{enumerate}
}

%
% 置換群表示マクロ
%
\makeatletter
\def\Perm#1{\@tempcnta\z@ \def\@uresult{}\def\@dresult{}\@tfor \@tempa:=#1\do{%
    \ifnum\@tempcnta>\z@
    \edef\@uresult{\@uresult &}\edef\@dresult{\@dresult &}\fi
    \advance\@tempcnta\@ne
    \edef\@uresult{\@uresult\the\@tempcnta}%
    \edef\@dresult{\@dresult\@tempa}}%
\begin{pmatrix}\@uresult\\\@dresult\end{pmatrix}}
\makeatother

\RequirePackage{mcommand}
